# Site config for taenae.app under /home/ubuntu/taenae
# Copy into /etc/caddy/Caddyfile (or import from there).
#
# Layout:
#   /                      → portal (www/portal)
#   /hunger_games/*        → published dist (www/hunger_games)
#   /api/kokoro*           → Docker Kokoro on 127.0.0.1:8880
#   /api/image-search*     → image-search service on 127.0.0.1:4174

taenae.app {
	encode gzip

	handle_path /api/kokoro* {
		reverse_proxy 127.0.0.1:8880
	}

	handle /api/image-search* {
		reverse_proxy 127.0.0.1:4174
	}

	handle /hunger_games/* {
		root * /home/ubuntu/taenae/www
		try_files {path} /hunger_games/index.html
		file_server
	}

	handle {
		root * /home/ubuntu/taenae/www/portal
		file_server
	}
}
