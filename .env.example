# Public URL prefix for the built app (leading + trailing slash).
# Default in code is /hunger_games/ (taenae.app/hunger_games).
# VITE_BASE=/hunger_games/
#
# Optional: serve at the host root instead.
# VITE_BASE=/

# Kokoro TTS base URL (no trailing slash).
# Dev and taenae.app both use the same-origin proxy.
# VITE_KOKORO_URL=/api/kokoro
